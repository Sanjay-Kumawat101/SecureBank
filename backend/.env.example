# Copy this file to .env and fill in real values.

# Preferred: a single connection string. If set, this takes priority over
# the individual PG* vars below.
DATABASE_URL=postgresql://securebank:securebank@localhost:5432/securebank

# Individual vars, used only if DATABASE_URL is not set.
PGHOST=localhost
PGPORT=5432
PGUSER=securebank
PGPASSWORD=securebank
PGDATABASE=securebank

# Express session secret - use a long random string in real deployments.
SESSION_SECRET=change-this-to-a-long-random-string

# Port the API server listens on.
PORT=4000

# Frontend origin allowed by CORS (comma-separated if you need more than one).
CORS_ORIGIN=http://localhost:5173

NODE_ENV=development
